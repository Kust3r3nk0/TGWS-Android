# Create this file outside Git at /etc/tgws-relay/relay.env with mode 0600.
# Generate on the VPS: openssl rand -hex 32. Keep the existing token during updates.
TGWS_RELAY_TOKEN=REPLACE_WITH_64_HEX_FROM_YOUR_VPS
TGWS_TLS_KEY=/etc/tgws-relay/privkey.pem
TGWS_TLS_CERT=/etc/tgws-relay/fullchain.pem
TGWS_LISTEN_HOST=0.0.0.0
TGWS_LISTEN_PORT=443
TGWS_MAX_SESSIONS=8
TGWS_CONNECT_MS=8000
TGWS_IDLE_MS=300000
TGWS_WRITE_MS=10000
